{
  "deployment_url": "URL_OF_YOUR_TOOLING_INSTANCE",
  "auth_token": "NOT_USED_NOW",
  "timeout": 120,
  "ssl_verify": false,
  "servers": {
    "Playwright_MCP": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--caps", "vision",
        "--image-responses", "allow",
        "--viewport-size", "1280x720",
        "--timeout-action", "60000",
        "--isolated"
      ],
      "stateful": true
    },
    "calypso": {
      "type": "http",
      "url": "http://10.74.50.164:9586/mcp",
      "headers": {
        "X-User-Token": ""
      },
      "stateful": false
    },
    "playstation": {
      "type": "stdio",
      "command": "playstation-mcp-server",
      "args": ["serve"],
      "env": {
        "PS5_HOST_IP": "192.168.X.X"
      },
      "stateful": true
    }
  }
}

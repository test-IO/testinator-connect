# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit your actual certificates.
#
# Used by: npm run dist:mac:signed
#
# CSC_LINK      — base64-encoded Developer ID Application .p12 certificate
#                 Generate with: base64 -i ~/path/to/certificate.p12 | pbcopy
#
# CSC_KEY_PASSWORD — the password you set when exporting the .p12 from Keychain

CSC_LINK=
CSC_KEY_PASSWORD=

# Airbrake error reporting — baked into the app bundle at build time (see
# electron.vite.config.ts), since a packaged app has no CI-set env vars at
# runtime. Leaving these unset disables error reporting entirely (safe for
# local dev builds). Get these from the Airbrake project settings page.
#
# AIRBRAKE_PROJECT_ID  — numeric project ID
# AIRBRAKE_PROJECT_KEY — project API key

AIRBRAKE_PROJECT_ID=
AIRBRAKE_PROJECT_KEY=

# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit your actual certificates.
#
# Used by: npm run dist:mac:signed
#
# CSC_LINK      — base64-encoded Developer ID Application .p12 certificate
#                 Generate with: base64 -i ~/path/to/certificate.p12 | pbcopy
#
# CSC_KEY_PASSWORD — the password you set when exporting the .p12 from Keychain

CSC_LINK=
CSC_KEY_PASSWORD=

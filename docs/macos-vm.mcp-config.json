{
  "MacOS_VM": {
    "type": "stdio",
    "command": "ssh",
    "args": [
      "-T",
      "-o", "BatchMode=yes",
      "-o", "StrictHostKeyChecking=no",
      "-o", "UserKnownHostsFile=/dev/null",
      "-o", "LogLevel=ERROR",
      "-o", "ConnectTimeout=10",
      "-o", "ServerAliveInterval=15",
      "lume@VM_IP_ADDRESS",
      "/Users/lume/.local/bin/cua-driver",
      "mcp"
    ],
    "stateful": true
  }
}
